<script>
// ======================================================
// DATA & STATE
// ======================================================
let currentUser = null;
let openFolderId = null;

const DEFAULT_ACCOUNTS = [
  { username:'sheira', password:'sheira123', name:'Sheira Najwa Azzaliya', bio:'Mahasiswi yang penuh semangat, suka belajar hal baru ✨', photo:null }
];

function getAccounts(){ const s=localStorage.getItem('sn_accs'); return s?JSON.parse(s):JSON.parse(JSON.stringify(DEFAULT_ACCOUNTS)); }
function saveAccounts(a){ localStorage.setItem('sn_accs',JSON.stringify(a)); }
function getFolders(u){ const s=localStorage.getItem('sn_f_'+u); if(s)return JSON.parse(s); return [{id:1,name:'Tugas 1',files:[]},{id:2,name:'Tugas 2',files:[]},{id:3,name:'Tugas 3',files:[]}]; }
function saveFolders(u,f){ localStorage.setItem('sn_f_'+u,JSON.stringify(f)); }
function nextId(arr){ return arr.length?Math.max(...arr.map(x=>x.id))+1:1; }

// ======================================================
// NAVIGATION
// ======================================================
function showPage(p){
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.nav-links a').forEach(x=>x.classList.remove('active'));
  document.getElementById('page-'+p).classList.add('active');
  const nl=document.getElementById('nl-'+p);
  if(nl)nl.classList.add('active');
  window.scrollTo(0,0);
}

function goTugas(){
  if(currentUser){ showPage('dashboard'); showDash('tugas'); }
  else { sessionStorage.setItem('dest','tugas'); showPage('login'); }
}

// ======================================================
// AUTH
// ======================================================
function doLogin(){
  const u=document.getElementById('loginUser').value.trim();
  const p=document.getElementById('loginPass').value;
  const err=document.getElementById('loginErr');
  if(!u||!p){showErr(err,'Username dan password wajib diisi!');return;}
  const accs=getAccounts();
  const found=accs.find(a=>a.username===u&&a.password===p);
  if(!found){showErr(err,'Username atau password salah!');return;}
  currentUser={...found};
  err.style.display='none';
  document.getElementById('loginUser').value='';
  document.getElementById('loginPass').value='';
  updateNav();
  updateStats();
  const dest=sessionStorage.getItem('dest')||'overview';
  sessionStorage.removeItem('dest');
  showPage('dashboard');
  showDash(dest==='tugas'?'tugas':'overview');
  showNotif('Selamat datang, '+currentUser.name.split(' ')[0]+'! 🌸','success');
}

function doRegister(){
  const name=document.getElementById('regName').value.trim();
  const u=document.getElementById('regUser').value.trim();
  const p=document.getElementById('regPass').value;
  const p2=document.getElementById('regPass2').value;
  const err=document.getElementById('regErr');
  if(!name||!u||!p){showErr(err,'Semua field wajib diisi!');return;}
  if(p.length<6){showErr(err,'Password minimal 6 karakter!');return;}
  if(p!==p2){showErr(err,'Konfirmasi password tidak cocok!');return;}
  const accs=getAccounts();
  if(accs.find(a=>a.username===u)){showErr(err,'Username sudah digunakan!');return;}
  accs.push({username:u,password:p,name,bio:'',photo:null});
  saveAccounts(accs);
  err.style.display='none';
  ['regName','regUser','regPass','regPass2'].forEach(id=>document.getElementById(id).value='');
  showNotif('Akun berhasil dibuat! Silakan login 🌸','success');
  showPage('login');
}

function doLogout(){
  currentUser=null; openFolderId=null;
  updateNav();
  showPage('home');
  showNotif('Berhasil logout. Sampai jumpa! 👋','success');
}

function showErr(el,msg){ el.textContent='❌ '+msg; el.style.display='block'; }

// ======================================================
// NAVBAR
// ======================================================
function updateNav(){
  const na=document.getElementById('navActions');
  if(currentUser){
    na.innerHTML=`<span style="font-size:13px;color:var(--muted)">Halo, <b style="color:var(--rose-dark)">${currentUser.name.split(' ')[0]}</b></span>
      <button class="btn btn-outline btn-sm" onclick="showPage('dashboard');showDash('overview')">Dashboard</button>
      <button class="btn btn-danger btn-sm" onclick="doLogout()">Logout</button>`;
  } else {
    na.innerHTML=`<button class="btn btn-outline btn-sm" onclick="showPage('login')">Login</button>`;
  }
}

// ======================================================
// DASHBOARD
// ======================================================
function showDash(s){
  ['overview','tugas','profile'].forEach(x=>{
    document.getElementById('dash-'+x).style.display=x===s?'block':'none';
    const sl=document.getElementById('sl-'+x);
    if(sl)sl.classList.toggle('active',x===s);
  });
  if(s==='tugas')renderFolders();
  if(s==='profile')loadProfile();
}

function updateStats(){
  if(!currentUser)return;
  document.getElementById('dashWelcome').textContent='Selamat datang, '+currentUser.name.split(' ')[0]+'! 🌸';
  document.getElementById('sbName').textContent=currentUser.name.split(' ')[0];
  const folders=getFolders(currentUser.username);
  let tf=0,td=0;
  folders.forEach(f=>{tf+=f.files.length;td+=f.files.filter(x=>x.status==='done').length;});
  document.getElementById('stFolders').textContent=folders.length;
  document.getElementById('stFiles').textContent=tf;
  document.getElementById('stDone').textContent=td;
  refreshAvatars();
}

function refreshAvatars(){
  if(!currentUser)return;
  const init=currentUser.name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase();
  const html=currentUser.photo?`<img src="${currentUser.photo}" alt="">`  :init;
  ['heroAvatar','sbAvatar','profileAv'].forEach(id=>{
    const el=document.getElementById(id); if(el)el.innerHTML=html;
  });
}

// ======================================================
// FOLDERS
// ======================================================
function renderFolders(){
  if(!currentUser)return;
  const folders=getFolders(currentUser.username);
  document.getElementById('folderGrid').innerHTML=folders.map(f=>`
    <div class="folder-card" onclick="openFolder(${f.id})">
      <div class="fc-btns">
        <button class="fc-btn" onclick="event.stopPropagation();startEdit(${f.id},'${f.name.replace(/'/g,"\\'")}')">✏️</button>
        <button class="fc-btn" onclick="event.stopPropagation();delFolder(${f.id})">🗑️</button>
      </div>
      <span class="fc-emoji">🗂️</span>
      <div class="fc-name">${f.name}</div>
      <div class="fc-count">${f.files.length} file</div>
    </div>
  `).join('')+`
    <div class="add-folder" onclick="openModal('mAddFolder')">
      <span class="add-folder-plus">＋</span>
      <span class="add-folder-lbl">Tambah Folder</span>
    </div>`;
  document.getElementById('newFolderName').placeholder='contoh: Tugas '+(folders.length+1);
}

function addFolder(){
  const name=document.getElementById('newFolderName').value.trim();
  if(!name){showNotif('Nama folder tidak boleh kosong!','error');return;}
  const folders=getFolders(currentUser.username);
  folders.push({id:nextId(folders),name,files:[]});
  saveFolders(currentUser.username,folders);
  document.getElementById('newFolderName').value='';
  closeModal('mAddFolder');
  renderFolders(); updateStats();
  showNotif('Folder "'+name+'" berhasil dibuat! 🎉','success');
}

function delFolder(id){
  if(!confirm('Hapus folder ini beserta semua filenya?'))return;
  let f=getFolders(currentUser.username).filter(x=>x.id!==id);
  saveFolders(currentUser.username,f);
  renderFolders(); updateStats();
  showNotif('Folder berhasil dihapus!','success');
}

function startEdit(id,name){
  document.getElementById('editFolderId').value=id;
  document.getElementById('editFolderName').value=name;
  openModal('mEditFolder');
}

function saveEditFolder(){
  const id=parseInt(document.getElementById('editFolderId').value);
  const name=document.getElementById('editFolderName').value.trim();
  if(!name)return;
  const folders=getFolders(currentUser.username);
  const f=folders.find(x=>x.id===id); if(f)f.name=name;
  saveFolders(currentUser.username,folders);
  closeModal('mEditFolder'); renderFolders();
  showNotif('Nama folder berhasil diubah!','success');
}

// ======================================================
// FILES
// ======================================================
function openFolder(id){
  openFolderId=id;
  const folder=getFolders(currentUser.username).find(f=>f.id===id);
  if(!folder)return;
  document.getElementById('vFolderTitle').textContent='📂 '+folder.name;
  document.getElementById('vFolders').style.display='none';
  document.getElementById('vFiles').style.display='block';
  renderFiles();
}

function backToFolders(){
  openFolderId=null;
  document.getElementById('vFolders').style.display='block';
  document.getElementById('vFiles').style.display='none';
  renderFolders();
}

function renderFiles(){
  const folder=getFolders(currentUser.username).find(f=>f.id===openFolderId);
  if(!folder)return;
  document.getElementById('vFolderMeta').textContent=folder.files.length+' file';
  const list=document.getElementById('fileList');
  const empty=document.getElementById('fileEmpty');
  if(!folder.files.length){empty.style.display='block';list.innerHTML='';return;}
  empty.style.display='none';
  list.innerHTML=folder.files.map(f=>`
    <div class="file-item">
      <div class="fi-icon">${fileIcon(f.ext)}</div>
      <div class="fi-info">
        <div class="fi-name">${f.name}</div>
        <div class="fi-meta">${fmtSize(f.size)} · ${f.date}</div>
      </div>
      <div class="fi-actions">
        <span class="badge ${f.status==='done'?'badge-ok':'badge-pending'}">${f.status==='done'?'✅ Dikumpulkan':'⏳ Belum'}</span>
        ${f.status!=='done'?`<button class="btn btn-success btn-sm" onclick="collectFile('${f.id}')">Kumpulkan</button>`:''}
        <button class="btn btn-danger btn-sm" onclick="delFile('${f.id}')">🗑️</button>
      </div>
    </div>
  `).join('');
  updateStats();
}

function uploadFiles(files){
  if(!files||!files.length)return;
  const allowed=['html','css','js','pdf','doc','docx','zip','rar','jpg','jpeg','png','txt'];
  const folders=getFolders(currentUser.username);
  const folder=folders.find(f=>f.id===openFolderId);
  if(!folder)return;
  let ok=0,skip=0;
  Array.from(files).forEach(file=>{
    const ext=file.name.split('.').pop().toLowerCase();
    if(!allowed.includes(ext)||file.size>10*1024*1024){skip++;return;}
    folder.files.push({
      id:Date.now()+'_'+Math.random().toString(36).slice(2,6),
      name:file.name, ext, size:file.size,
      date:new Date().toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}),
      status:'not_done'
    });
    ok++;
  });
  saveFolders(currentUser.username,folders);
  closeModal('mUpload');
  document.getElementById('fileInput').value='';
  renderFiles();
  if(ok)showNotif(ok+' file berhasil diupload! 🎉','success');
  if(skip)showNotif(skip+' file dilewati (tipe/ukuran tidak valid)','error');
}

function collectFile(id){
  const folders=getFolders(currentUser.username);
  const folder=folders.find(f=>f.id===openFolderId);
  const file=folder&&folder.files.find(f=>f.id===id);
  if(file)file.status='done';
  saveFolders(currentUser.username,folders);
  renderFiles();
  showNotif('Tugas berhasil dikumpulkan! ✅','success');
}

function delFile(id){
  if(!confirm('Hapus file ini?'))return;
  const folders=getFolders(currentUser.username);
  const folder=folders.find(f=>f.id===openFolderId);
  if(folder)folder.files=folder.files.filter(f=>f.id!==id);
  saveFolders(currentUser.username,folders);
  renderFiles();
  showNotif('File berhasil dihapus!','success');
}

// ======================================================
// PROFILE
// ======================================================
function loadProfile(){
  if(!currentUser)return;
  document.getElementById('editName').value=currentUser.name;
  document.getElementById('editUser').value=currentUser.username;
  document.getElementById('editBio').value=currentUser.bio||'';
  document.getElementById('editPass').value='';
  refreshAvatars();
}

function saveProfile(){
  const name=document.getElementById('editName').value.trim();
  const u=document.getElementById('editUser').value.trim();
  const bio=document.getElementById('editBio').value.trim();
  const pass=document.getElementById('editPass').value;
  if(!name||!u){showNotif('Nama dan username tidak boleh kosong!','error');return;}
  const accs=getAccounts();
  if(u!==currentUser.username&&accs.find(a=>a.username===u)){showNotif('Username sudah digunakan!','error');return;}
  if(u!==currentUser.username){
    const folders=getFolders(currentUser.username);
    localStorage.removeItem('sn_f_'+currentUser.username);
    saveFolders(u,folders);
  }
  const idx=accs.findIndex(a=>a.username===currentUser.username);
  if(idx<0)return;
  accs[idx].name=name; accs[idx].username=u; accs[idx].bio=bio;
  if(pass.length>=6)accs[idx].password=pass;
  if(currentUser.photo)accs[idx].photo=currentUser.photo;
  saveAccounts(accs);
  currentUser={...accs[idx]};
  document.getElementById('heroBio').textContent=bio||'Sheira Najwa Azzaliya — seorang mahasiswi yang penuh semangat.';
  updateStats();
  showNotif('Profil berhasil disimpan! 🎉','success');
}

function changePhoto(input){
  if(!input.files||!input.files[0])return;
  const file=input.files[0];
  if(file.size>2*1024*1024){showNotif('Ukuran foto maksimal 2MB!','error');return;}
  const reader=new FileReader();
  reader.onload=e=>{
    currentUser.photo=e.target.result;
    const accs=getAccounts();
    const idx=accs.findIndex(a=>a.username===currentUser.username);
    if(idx>=0){accs[idx].photo=e.target.result;saveAccounts(accs);}
    refreshAvatars();
    showNotif('Foto profil berhasil diubah! 📷','success');
  };
  reader.readAsDataURL(file);
}

// ======================================================
// HELPERS
// ======================================================
function fileIcon(ext){
  const m={pdf:'📄',doc:'📝',docx:'📝',jpg:'🖼️',jpeg:'🖼️',png:'🖼️',zip:'🗜️',rar:'🗜️',html:'🌐',css:'🎨',js:'⚡',txt:'📃'};
  return m[(ext||'').toLowerCase()]||'📁';
}
function fmtSize(b){
  if(!b)return'–';
  if(b<1024)return b+'B';
  if(b<1048576)return(b/1024).toFixed(1)+'KB';
  return(b/1048576).toFixed(1)+'MB';
}
function openModal(id){document.getElementById(id).classList.add('show');}
function closeModal(id){document.getElementById(id).classList.remove('show');}
document.querySelectorAll('.modal-bg').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('show');}));

function showNotif(msg,type){
  const el=document.createElement('div');
  el.className='notif notif-'+type;
  el.innerHTML=(type==='success'?'✅ ':'❌ ')+msg;
  document.body.appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transform='translateX(20px)';el.style.transition='all 0.4s';setTimeout(()=>el.remove(),400);},3500);
}
</script>
